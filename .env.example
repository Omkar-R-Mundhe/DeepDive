# Select "mesh" for the hackathon configuration, "gemini" for direct testing,
# or "openrouter" for access to models available in your OpenRouter account.
LLM_PROVIDER=mesh

MESH_API_KEY=your_mesh_api_key_here
MESH_MODEL=openai/gpt-4o

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=provider/model-id

# Tavily provides 1,000 free search credits per month; Brave remains optional.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
